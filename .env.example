# Server
PORT=4321
# Public base URL. NanoBanana/VEO3 must be able to download the reference image from here.
# On localhost the app automatically falls back to inlining the image bytes instead.
PUBLIC_URL=http://localhost:4321

# Set to 1 to force the built-in fakes even when keys are present (safe demo runs).
MOCK_MODE=0

# OpenAI - image analysis, prompt agents, captions, carousel planning
OPENAI_API_KEY=
OPENAI_VISION_MODEL=chatgpt-4o-latest
OPENAI_AGENT_MODEL=gpt-4.1-mini
OPENAI_CAPTION_MODEL=gpt-4o

# fal.ai - NanoBanana (image edit + text-to-image) and Tripo3D (image/text-to-3D), same key
FAL_API_KEY=
# Optional: swap the Tripo3D model variant used for the 3D Karakter content type
# FAL_3D_IMAGE_URL=https://queue.fal.run/tripo3d/h3.1/image-to-3d
# FAL_3D_TEXT_URL=https://queue.fal.run/tripo3d/h3.1/text-to-3d

# kie.ai - VEO3 video generation (Normal Video + UGC Reklam only)
KIE_API_KEY=

# Membership sessions (how long a login stays valid)
SESSION_TTL_MS=2592000000

# Free credit system (see server/credits.js) - set to 0 to disable entirely (unmetered).
# Mock-mode runs never consume a credit regardless of this setting.
CREDIT_SYSTEM_ENABLED=1
FREE_CREDITS_ON_SIGNUP=2

# Render polling (the workflow used fixed 20s waits)
POLL_INITIAL_DELAY_MS=20000
POLL_INTERVAL_MS=10000
IMAGE_TIMEOUT_MS=300000
VIDEO_TIMEOUT_MS=900000
